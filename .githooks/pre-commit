#!/bin/sh
# Blocks commits that include secret files or private keys, no matter which
# tool (a person, Claude, Cursor, Codex, ...) makes the commit.
# Managed by claude-init.
#
# Enable once per clone:  git config core.hooksPath .githooks

status=0

if command -v node >/dev/null 2>&1 && [ -f agent-guardrails/policy.mjs ]; then
  # Same secret rules the agents get, including "secretPaths" from
  # agent-guardrails/config.json.
  found=$(git diff --cached --name-only --diff-filter=ACMR | node agent-guardrails/policy.mjs --check-staged)
  rc=$?
  if [ $rc -ne 0 ] && [ $rc -ne 3 ]; then
    echo "pre-commit: the secret check crashed (exit $rc). Fix agent-guardrails/policy.mjs or config.json." >&2
    status=1
  fi
  for f in $found; do
    echo "pre-commit: refusing to commit secret file: $f" >&2
    status=1
  done
else
  echo "pre-commit: node not found, checking built-in secret names only" >&2
  for f in $(git diff --cached --name-only --diff-filter=ACMR); do
    base=$(basename "$f")
    case "$base" in
      *.example|*.sample|*.template) continue ;;
      .env|.env.*|private.pem|*.key|*.p12|*.pfx)
        echo "pre-commit: refusing to commit secret file: $f" >&2
        status=1 ;;
    esac
  done
fi

if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+.*-----BEGIN ([A-Z]+ )?PRIVATE KEY-----' >/dev/null; then
  echo "pre-commit: a staged change contains a private key" >&2
  status=1
fi

if [ $status -ne 0 ]; then
  echo "pre-commit: unstage those files (git restore --staged <file>) and commit again." >&2
fi
exit $status
