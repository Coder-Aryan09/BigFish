# BigFish server the extension dials (HTTP base; the socket uses ws:// or wss:// on the same host).
WXT_SERVER_URL=http://127.0.0.1:8787
# Public key of the extension key pair (base64, no PEM header). Fixes the extension ID.
# Never put the private .pem here.
WXT_EXTENSION_KEY=
# Google OAuth client ID, type "Chrome Extension", created for the fixed extension ID.
WXT_GOOGLE_CLIENT_ID=
