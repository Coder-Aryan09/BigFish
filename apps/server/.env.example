PORT=8787
HOST=127.0.0.1
# Agent models. The first provider with a key wins: NVIDIA, OpenRouter, Mistral.
# NVIDIA: free key from build.nvidia.com.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_JUDGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openai/gpt-6-luna
# Optional. Defaults to OPEN_ROUTER_MODEL.
OPEN_ROUTER_JUDGE_MODEL=
MISTRAL_API_KEY=
AGENT_MODEL=mistral-medium-latest
# Cheaper model that checks each subtask (the verifier).
AGENT_JUDGE_MODEL=mistral-small-latest
TINYFISH_API_KEY=
TINYFISH_REPLAY=0
# Google login (step 2). OAuth client of type "Chrome Extension" for EXTENSION_ID.
GOOGLE_EXTENSION_CLIENT_ID=
# Signs BigFish session JWTs (HS256). At least 32 random characters.
JWT_SECRET=
# Fixed extension ID (from the public key in the extension's manifest). /mcp-ws only accepts this Origin.
EXTENSION_ID=
# Dev-only routes (dev login, device list, ping). Never enable in production.
# With dev routes on, missing auth values above only log a warning.
ENABLE_DEV_ROUTES=0
