{
  "name": "bigfish",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22" },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "pnpm --filter @bigfish/server dev",
    "dev:ext": "pnpm --filter @bigfish/extension dev",
    "dev:ml": "uv --directory ML run python -m ML.src.server",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
